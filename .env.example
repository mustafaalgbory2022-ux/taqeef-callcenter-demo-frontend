# Developer/integration settings only (administrators never edit files).
# mock = synthetic data + simulated backend in the browser (default)
# live = same-origin FastAPI at /api
VITE_API_MODE=mock
# browser (default, needs SPA fallback in FastAPI) | hash
VITE_ROUTER_MODE=browser
# Dev-server proxy target for /api when VITE_API_MODE=live (not bundled)
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
