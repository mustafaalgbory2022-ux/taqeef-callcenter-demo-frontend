# mock = synthetic in-browser data (default). fastapi = real HTTP calls to the local backend.
VITE_API_MODE=mock
# Base path or URL of the FastAPI backend when VITE_API_MODE=fastapi.
VITE_API_BASE_URL=/api
# Dev-server proxy target for /api (not exposed to the browser bundle).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
